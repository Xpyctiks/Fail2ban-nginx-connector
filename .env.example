# nginx map file with banned IPs ("<ip> 1;" per line)
BAN_FILE=/etc/nginx/additional-configs/banned-ip.conf
LOG_FILE=/etc/nginx/fail2ban-connector.log

# Marker file: created by ban/unban, consumed by "reload"
RELOAD_MARKER=/run/fail2ban-nginx-connector.reload
LOCK_FILE=/run/fail2ban-nginx-connector.lock

#Server name to be shown in Telegramm messages as the sender
SERVER_NAME="server.com"

#Send to Telegramm reports of every Nginx reload. Default 0. 0 = NO, 1 = YES
NGINX_RELOAD_REPORT=0

# Telegram bot
TELEGRAM_TOKEN=123456789:REPLACE_WITH_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_CHAT_ID
